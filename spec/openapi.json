{
  "components": {
    "schemas": {
      "HealthResponse": {
        "description": "The `/healthz` body — §6.1.",
        "properties": {
          "status": {
            "description": "Always `\"ok\"`; the endpoint does not answer otherwise.",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "RateLimitDefaultView": {
        "description": "A built-in default in the `/v1/rate-limits` document.",
        "properties": {
          "endpoint": {
            "description": "The endpoint class.",
            "type": "string"
          },
          "limit": {
            "description": "Requests allowed per window.",
            "format": "int32",
            "type": "integer"
          },
          "window_secs": {
            "description": "Window length in seconds.",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "endpoint",
          "limit",
          "window_secs"
        ],
        "type": "object"
      },
      "RateLimitItem": {
        "description": "One configured layer in `PATCH /v1/rate-limits` — §6.2.",
        "properties": {
          "client_id": {
            "description": "The protocol client id for a per-client layer; absent for the tenant-wide layer.",
            "type": [
              "string",
              "null"
            ]
          },
          "endpoint": {
            "description": "`authorize` | `token` | `userinfo` | `management`.",
            "type": "string"
          },
          "limit": {
            "description": "Requests allowed per window.",
            "format": "int32",
            "type": "integer"
          },
          "window_secs": {
            "description": "Window length in seconds.",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "endpoint",
          "limit",
          "window_secs"
        ],
        "type": "object"
      },
      "RateLimitView": {
        "description": "One configured row in the `/v1/rate-limits` document.",
        "properties": {
          "client_id": {
            "description": "The protocol client id, or `null` for the tenant-wide layer.",
            "type": [
              "string",
              "null"
            ]
          },
          "endpoint": {
            "description": "The endpoint class.",
            "type": "string"
          },
          "limit": {
            "description": "Requests allowed per window.",
            "format": "int32",
            "type": "integer"
          },
          "window_secs": {
            "description": "Window length in seconds.",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "endpoint",
          "limit",
          "window_secs"
        ],
        "type": "object"
      },
      "RateLimitsDocument": {
        "description": "`GET`/`PATCH /v1/rate-limits` response — §6.2.",
        "properties": {
          "defaults": {
            "description": "The built-in defaults, always present.",
            "items": {
              "$ref": "#/components/schemas/RateLimitDefaultView"
            },
            "type": "array"
          },
          "items": {
            "description": "Every configured layer.",
            "items": {
              "$ref": "#/components/schemas/RateLimitView"
            },
            "type": "array"
          }
        },
        "required": [
          "defaults",
          "items"
        ],
        "type": "object"
      },
      "RateLimitsPatch": {
        "description": "`PATCH /v1/rate-limits` body.",
        "properties": {
          "items": {
            "description": "The complete replacement set. An empty list restores the built-in defaults.",
            "items": {
              "$ref": "#/components/schemas/RateLimitItem"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "VersionResponse": {
        "description": "The `/version` body.",
        "properties": {
          "name": {
            "description": "The binary's package name.",
            "type": "string"
          },
          "version": {
            "description": "The version it was built from.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "type": "object"
      }
    }
  },
